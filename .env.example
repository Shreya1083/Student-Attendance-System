# ==============================================================================
# CampusTrack - Docker Environment Variables Template (.env.example)
# Copy this file to .env before starting containers:
#   copy .env.example .env
# ==============================================================================

# Application Environment
NODE_ENV=production

# Server Backend Configuration
BACKEND_PORT=5000
MONGODB_URI=mongodb://mongodb:27017/student_attendance_db

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=8h

# CORS & Client URL Configuration
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Frontend Port Mapping (Host:Container)
FRONTEND_PORT=5173

# MongoDB Container Configuration
MONGO_INITDB_DATABASE=student_attendance_db
MONGO_PORT=27017
