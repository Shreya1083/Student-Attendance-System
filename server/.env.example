# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/student_attendance_db

# Security & JWT Configuration
JWT_SECRET=replace_with_a_secure_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=8h

# Allowed CORS Origin (Frontend Vite Client)
CLIENT_URL=http://localhost:5173

# Rate Limiting (15 minutes window, 100 requests per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
